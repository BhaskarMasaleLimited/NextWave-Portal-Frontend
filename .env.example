# ─────────────────────────────────────────────────────────────
# Bhaskar Foods — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# ── Upstash Redis ─────────────────────────────────────────────
# Get these from your Upstash dashboard: https://console.upstash.com
#
# Steps:
#   1. Sign up free at https://upstash.com
#   2. Create a new Redis database (select region closest to you)
#   3. Go to the database page → "REST API" tab
#   4. Copy UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN below
#
# If these are left empty, the app works fine without caching.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
